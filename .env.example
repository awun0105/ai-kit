# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY="your-llm-api-key" # e.g. OpenAI API key
DEFAULT_LLM_MODEL=gpt-5.6-luna

# Atlas Cloud (OpenAI-compatible) — alternative to OpenAI, access 59+ LLMs with one key
# Get your free key at: https://www.atlascloud.ai/console/coding-plan
# OPENAI_BASE_URL=https://api.atlascloud.ai/v1
# OPENAI_API_KEY=<your-atlascloud-key>
# DEFAULT_LLM_MODEL=deepseek-ai/deepseek-v4-pro
DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=true

# Tools: MCP and A2A (see docs/tools.md)
# MCP_CONFIG_FILE=mcp.json               # {"mcpServers": {...}}, ${VAR} expanded from the environment
# MCP_TOOL_ALLOWLIST=orders_get_order
# MCP_SERVER_TOKEN=                      # for `python -m app.mcp_server --http`
A2A_ENABLED=false                        # needs `uv sync --extra a2a`
# A2A_SERVER_TOKEN=                     # one caller ("default"), or one token per caller:
# A2A_SERVER_TOKENS=billing=tok-1,crm=tok-2
# A2A_PUBLIC_URL=http://localhost:8000/a2a
# A2A_REMOTE_AGENTS=billing=https://billing.example.com/a2a
# A2A_REMOTE_TOKEN_BILLING=

# Deep research team (see docs/agents.md); needs `uv sync --extra deep`
DEEP_RESEARCH_ENABLED=false
DEEP_RESEARCH_MAX_MODEL_CALLS=40
DEEP_RESEARCH_MAX_TOOL_CALLS=80

# Cost guard (see docs/deployment.md): monthly USD budget per user, 0 = off
COST_MONTHLY_BUDGET_USD=0
# COST_PRICES_JSON='{"gpt-5.4-mini": [0.25, 2.0]}'   # USD per 1M tokens [input, output]; use your real prices
COST_DEFAULT_INPUT_PER_1M=0
COST_DEFAULT_OUTPUT_PER_1M=0

# Reliability (see docs/reliability.md)
MAX_LLM_CALL_RETRIES=2                # attempts per model; the only retry layer
LLM_ATTEMPT_TIMEOUT=25
LLM_TOTAL_TIMEOUT=90                  # must fit retries x attempt timeout + one fallback attempt
LLM_RETRY_BUDGET_RATIO=0.1
LLM_BREAKER_FAILURE_RATE=0.5
LLM_BREAKER_SLOW_CALL_S=20
LLM_BREAKER_OPEN_S=30
ANSWER_CACHE_ENABLED=false            # needs RAG_ENABLED=true
ANSWER_CACHE_TTL_S=3600
ANSWER_CACHE_MAX_STALE_S=86400

# RAG Settings (see docs/rag.md). Ingest with: uv run python -m scripts.ingest <folder>
RAG_ENABLED=false
RAG_VECTOR_STORE=pgvector              # pgvector | memory
RAG_EMBEDDING_PROVIDER=openai          # openai (any OpenAI-compatible endpoint) | hashing (offline, tests only)
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIM=1536
# RAG_EMBEDDING_BASE_URL=              # set for a non-OpenAI endpoint
# RAG_EMBEDDING_API_KEY=               # defaults to OPENAI_API_KEY
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3
RAG_LEXICAL_TOKENIZER=auto            # auto | vi | simple (re-ingest after changing)
# RAG_RERANKER=BAAI/bge-reranker-v2-m3  # empty = off; needs `uv sync --extra rerank`
# RAG_RERANKER_TYPE=cross-encoder
RAG_RERANK_CANDIDATES=20

# Guardrails (see docs/guardrails.md). Deterministic rails are on by default.
GUARD_ENABLED=true
GUARD_BLOCK_INJECTION=true
GUARD_INPUT_PII_ACTION=redact         # redact | block | allow
GUARD_OUTPUT_REDACTION=true
# GUARD_PII_ALLOWLIST=@yourcompany.com,1900xxxx
# GUARD_DENYLIST=db.internal.example,demo-password
# GUARD_APPROVAL_TOOLS=transfer_money,delete_account
# GUARD_EGRESS_ALLOWLIST=api.yourcompany.com
GUARD_SCREEN_TOOL_OUTPUT=true
GUARD_LLM_RAIL_ENABLED=false
# GUARD_LLM_RAIL_POLICY="Answers employees' questions about HR policy."
# GUARD_LLM_RAIL_MODEL=gpt-5.4-nano
GUARD_LLM_RAIL_FAIL_MODE=open         # open | closed
# GUARD_REFUSAL_MESSAGE="Xin lỗi, tôi không thể hỗ trợ yêu cầu này."

# JWT Settings
JWT_SECRET_KEY="CHANGE_ME_TO_A_RANDOM_32_PLUS_CHAR_STRING"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
